{
  description = "kikoeru-neo: self-hosted player for audio dramas and audiobooks";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
  # Rust dependency builds can be reused when the toolchain, build settings,
  # lockfile and other derivation inputs remain unchanged.
  inputs.crane.url = "github:ipetkov/crane";

  outputs = { self, nixpkgs, crane }:
    let
      systems = [ "x86_64-linux" "aarch64-linux" ];
      forAllSystems = f: nixpkgs.lib.genAttrs systems (system: f nixpkgs.legacyPackages.${system});
      fs = nixpkgs.lib.fileset;
      # Restrict each source set to its build inputs. An embedded frontend
      # still makes the server depend on the web build through copyWeb.
      rustSrc = fs.toSource {
        root = ./.;
        fileset = fs.unions [ ./Cargo.toml ./Cargo.lock ./crates ./contract ];
      };
      webSrc = fs.toSource {
        root = ./.;
        fileset = fs.unions [
          ./web/package.json
          ./web/pnpm-lock.yaml
          ./web/pnpm-workspace.yaml
          ./web/tsconfig.json
          ./web/vite.config.ts
          ./web/playwright.config.ts
          ./web/playwright.mock.config.ts
          ./web/src
          ./web/static
          ./web/e2e
          ./web/e2e-mock
          # Mock mode and its type check import the contract samples.
          ./contract
        ];
      };
      # The release tag is checked against this, so the packages and the
      # image tag follow Cargo.toml instead of a second copy of the number.
      version = (builtins.fromTOML (builtins.readFile ./Cargo.toml)).workspace.package.version;
      rustCommon = {
        pname = "kikoeru-neo";
        inherit version;
        src = rustSrc;
        strictDeps = true;
        # Query macros read the committed .sqlx metadata, so the build needs
        # no database.
        env.SQLX_OFFLINE = "true";
      };
      # Clippy, the tests and neo-typegen use the dev profile, which skips the
      # release profile's fat LTO. Every one of them reuses devDeps, built
      # with the feature set of the test build so the dependencies compile once.
      rustDev = pkgs: rec {
        craneLib = crane.mkLib pkgs;
        args = rustCommon // {
          CARGO_PROFILE = "dev";
          cargoExtraArgs = "--locked --workspace --features neo-server/embed-web";
        };
        deps = craneLib.buildDepsOnly args;
      };
      # The tests and the release build compile the real frontend in.
      copyWeb = pkgs: ''
        mkdir -p web
        cp -r ${neoWeb pkgs} web/build
      '';
      # The desktop app also runs on Windows. nixpkgs has a cached MinGW cross
      # toolchain, so `cargo check` for that target runs here; macOS has no
      # cross toolchain from Linux and is only built by desktop.yml on a
      # GitHub-hosted macOS runner.
      crossWindows = pkgs:
        let
          mingw = pkgs.pkgsCross.mingwW64;
          # A native toolchain whose rustc also has the Windows std, so build
          # scripts and proc macros (sqlx's bundles SQLite) still build for
          # Linux with the native C compiler.
          craneLib = (crane.mkLib pkgs).overrideScope (_: _: { rustc = mingw.buildPackages.rustc; });
          args = rustCommon // {
            pname = "neo-check-windows";
            doCheck = false;
            nativeBuildInputs = [ mingw.stdenv.cc ];
            cargoExtraArgs = "--locked --target x86_64-pc-windows-gnu -p neo-core -p neo-storage -p neo-scanner -p neo-server";
            env = rustCommon.env // {
              CC_x86_64_pc_windows_gnu = "x86_64-w64-mingw32-gcc";
              AR_x86_64_pc_windows_gnu = "x86_64-w64-mingw32-ar";
            };
            buildPhaseCargoCommand = "cargoWithProfile check ${args.cargoExtraArgs}";
          };
        in
        craneLib.mkCargoDerivation (args // {
          cargoArtifacts = craneLib.buildDepsOnly args;
          doInstallCargoArtifacts = false;
        });
      # The Tauri desktop shell is its own Cargo workspace, so WebKitGTK never
      # enters the server build. It embeds the same frontend as the server.
      desktopSrc = fs.toSource {
        root = ./.;
        fileset = fs.unions [
          ./Cargo.toml ./Cargo.lock ./crates
          (fs.difference ./desktop/src-tauri (fs.unions [
            (fs.maybeMissing ./desktop/src-tauri/target)
            (fs.maybeMissing ./desktop/src-tauri/gen)
            (fs.maybeMissing ./desktop/src-tauri/permissions/autogenerated)
          ]))
        ];
      };
      desktopArgs = pkgs: {
        pname = "kikoeru-neo-desktop";
        inherit ((builtins.fromTOML (builtins.readFile ./desktop/src-tauri/Cargo.toml)).package) version;
        src = desktopSrc;
        strictDeps = true;
        cargoLock = ./desktop/src-tauri/Cargo.lock;
        cargoToml = ./desktop/src-tauri/Cargo.toml;
        # Cargo runs in the crate's own directory; its path dependency on
        # neo-server still finds crates/ two levels up.
        postUnpack = ''
          cd $sourceRoot/desktop/src-tauri
          sourceRoot=.
        '';
        cargoExtraArgs = "--locked";
        env.SQLX_OFFLINE = "true";
        preBuild = ''
          mkdir -p ../../web
          cp -r ${neoWeb pkgs} ../../web/build
        '';
      };
      neoDesktop = pkgs:
        let
          craneLib = crane.mkLib pkgs;
          args = desktopArgs pkgs // {
            nativeBuildInputs = [ pkgs.pkg-config pkgs.wrapGAppsHook3 pkgs.clippy ];
            buildInputs = with pkgs; [
              webkitgtk_4_1 gtk3 libsoup_3 glib-networking librsvg dbus libayatana-appindicator
              # WebKitGTK plays audio and video through GStreamer.
              gst_all_1.gstreamer gst_all_1.gst-plugins-base gst_all_1.gst-plugins-good
              gst_all_1.gst-plugins-bad gst_all_1.gst-libav
            ];
          };
          deps = craneLib.buildDepsOnly args;
        in
        craneLib.buildPackage (args // {
          cargoArtifacts = deps;
          doCheck = pkgs.stdenv.hostPlatform.isx86_64;
          # Tests that open a window make Tauri create the webview's data
          # directory under $HOME. The build's /homeless-shelter cannot be
          # created on every host, the GitHub runner among them.
          preCheck = ''
            export HOME="$TMPDIR"
          '';
          postCheck = ''
            cargo clippy --locked --offline --all-targets -- -D warnings
          '';
          # The tray loads the indicator library at run time. The local
          # backend runs ffmpeg and ffprobe by name, as no externalBin sits
          # next to this build. GStreamer's libav plugin already brings
          # ffmpeg-headless's libraries, so its binaries add under 1 MiB.
          preFixup = ''
            gappsWrapperArgs+=(--prefix LD_LIBRARY_PATH : ${pkgs.lib.makeLibraryPath [ pkgs.libayatana-appindicator ]})
            gappsWrapperArgs+=(--prefix PATH : ${pkgs.lib.makeBinPath [ pkgs.ffmpeg-headless ]})
          '';
          doInstallCheck = true;
          installCheckPhase = ''
            runHook preInstallCheck
            grep -qF ${pkgs.lib.makeBinPath [ pkgs.ffmpeg-headless ]} $out/bin/kikoeru-neo-desktop
            runHook postInstallCheck
          '';
          meta.mainProgram = "kikoeru-neo-desktop";
        });
      # `cargo check` of the shell for Windows, like crossWindows.
      desktopWindows = pkgs:
        let
          mingw = pkgs.pkgsCross.mingwW64;
          craneLib = (crane.mkLib pkgs).overrideScope (_: _: { rustc = mingw.buildPackages.rustc; });
          args = desktopArgs pkgs // {
            pname = "desktop-check-windows";
            doCheck = false;
            nativeBuildInputs = [ mingw.stdenv.cc ];
            cargoExtraArgs = "--locked --target x86_64-pc-windows-gnu";
            env = (desktopArgs pkgs).env // {
              CC_x86_64_pc_windows_gnu = "x86_64-w64-mingw32-gcc";
              AR_x86_64_pc_windows_gnu = "x86_64-w64-mingw32-ar";
            };
            buildPhaseCargoCommand = "cargoWithProfile check ${args.cargoExtraArgs}";
          };
        in
        craneLib.mkCargoDerivation (args // {
          cargoArtifacts = craneLib.buildDepsOnly args;
          doInstallCargoArtifacts = false;
        });
      neoTypegen = pkgs:
        let rust = rustDev pkgs; in
        rust.craneLib.buildPackage (rust.args // {
          pname = "neo-typegen";
          cargoArtifacts = rust.deps;
          cargoExtraArgs = "--locked -p neo-typegen";
          nativeBuildInputs = [ pkgs.nodejs_22 pkgs.typescript ];
          doCheck = pkgs.stdenv.hostPlatform.isx86_64;
          postCheck = ''
            cargoWithProfile run --locked --offline -p neo-typegen -- "$TMPDIR/types"
            node crates/neo-typegen/tests/check-contract.mjs "$TMPDIR/types"
            tsc --strict --noEmit --target ES2020 --module ESNext --moduleResolution bundler "$TMPDIR/types/contract-check.ts" "$TMPDIR/types/index.ts"
          '';
        });
      fallbackFonts = pkgs: import ./nix/fallback-fonts.nix { inherit pkgs; };
      # The ffmpeg the server package runs, without what it never uses.
      # Tests and the dev shell keep ffmpeg-headless, whose encoders make
      # their sample media.
      serverFfmpeg = pkgs: import ./nix/ffmpeg.nix {
        inherit pkgs;
        inputRs = ./crates/neo-media/src/input.rs;
      };
      # The SvelteKit build. Its dependencies come from a fixed-output fetch of
      # the lockfile, so the build itself runs offline.
      neoWeb = pkgs: pkgs.stdenvNoCC.mkDerivation (finalAttrs: {
        pname = "kikoeru-neo-web";
        inherit version;
        src = webSrc;
        pnpmRoot = "web";
        pnpmDeps = pkgs.fetchPnpmDeps {
          inherit (finalAttrs) pname version;
          src = fs.toSource {
            root = ./web;
            fileset = fs.unions [ ./web/package.json ./web/pnpm-lock.yaml ./web/pnpm-workspace.yaml ];
          };
          fetcherVersion = 4;
          hash = "sha256-LUIlI+Ki4uIKZoZlHO/DhX89CZSM0tVHVODvCGW5tOc=";
        };
        nativeBuildInputs = [ pkgs.nodejs_22 pkgs.pnpm pkgs.pnpmConfigHook (neoTypegen pkgs) ];
        # vite.config.ts resolves the fonts' imports from here.
        env.KIKOERU_FALLBACK_FONTS_DIR = "${fallbackFonts pkgs}";
        # `pnpm build` regenerates the types with cargo. Here the typegen
        # package writes them, then the steps after it run directly.
        buildPhase = ''
          runHook preBuild
          cd web
          neo-typegen src/lib/api/types
          pnpm exec svelte-kit sync
          pnpm exec vite build
          runHook postBuild
        '';
        doCheck = true;
        checkPhase = ''
          runHook preCheck
          pnpm exec svelte-check --tsconfig ./tsconfig.json
          pnpm exec vitest run
          # The contract samples are mock data. A production bundle that
          # contains one was built with VITE_API_MOCK=1.
          if grep -rq '示例社团' build; then
            echo "web/build contains the mock API" >&2
            exit 1
          fi
          runHook postCheck
        '';
        installPhase = ''
          runHook preInstall
          cp -r build $out
          install -Dm444 ${fallbackFonts pkgs}/LICENSE-latin.txt $out/licenses/fallback-font-latin.txt
          install -Dm444 ${fallbackFonts pkgs}/LICENSE-cjk.txt $out/licenses/fallback-font-cjk.txt
          runHook postInstall
        '';
      });
      # Playwright against the production package. The browsers come from
      # nixpkgs, whose playwright-driver must match @playwright/test.
      neoE2e = pkgs: server: pkgs.stdenvNoCC.mkDerivation {
        name = "kikoeru-neo-e2e";
        src = webSrc;
        pnpmRoot = "web";
        inherit ((neoWeb pkgs)) pnpmDeps;
        # The playback suite generates its media with ffmpeg at setup time.
        nativeBuildInputs = [ pkgs.nodejs_22 pkgs.pnpm pkgs.pnpmConfigHook pkgs.ffmpeg-headless ];
        env = {
          KIKOERU_NEO_BIN = pkgs.lib.getExe server;
          PLAYWRIGHT_BROWSERS_PATH = "${pkgs.playwright-driver.browsers}";
          PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS = "true";
          FONTCONFIG_FILE = pkgs.makeFontsConf { fontDirectories = [ pkgs.noto-fonts-cjk-sans ]; };
        };
        buildPhase = ''
          runHook preBuild
          cd web
          export HOME="$TMPDIR"
          export KIKOERU_E2E_LOG_DIR="$TMPDIR/e2e-logs"
          # Sample host-wide pressure and free memory to distinguish
          # resource contention from a slow or stalled test.
          pressure() {
            echo "=== pressure $1 at $(date -u +%H:%M:%S)"
            for r in cpu memory io; do
              if [ -r /proc/pressure/$r ]; then sed "s/^/$r /" /proc/pressure/$r; fi
            done
            grep -E '^(MemAvailable|SwapFree):' /proc/meminfo || true
          }
          pressure start
          (while true; do pressure sample; sleep 30; done) > "$TMPDIR/pressure.log" 2>&1 &
          sampler=$!
          # The sandbox is gone after a failure, so what explains it goes into
          # the build log: each failed test's page snapshot, the servers' last
          # lines and the pressure samples.
          if ! pnpm exec playwright test; then
            kill $sampler || true
            pressure failure
            cat "$TMPDIR/pressure.log"
            for f in test-results/*/error-context.md; do
              if [ -e "$f" ]; then echo "=== $f"; cat "$f"; fi
            done
            for f in "$KIKOERU_E2E_LOG_DIR"/*.log; do
              if [ -e "$f" ]; then echo "=== $f (last 200 lines)"; tail -n 200 "$f"; fi
            done
            exit 1
          fi
          kill $sampler || true
          runHook postBuild
        '';
        installPhase = "touch $out";
      };
      # The UI flows against `vite dev` in mock mode, where the contract
      # samples answer the API (web/playwright.mock.config.ts). Most pages and
      # settings are only covered here, not by the production-package suite.
      neoE2eMock = pkgs: pkgs.stdenvNoCC.mkDerivation {
        name = "kikoeru-neo-e2e-mock";
        src = webSrc;
        pnpmRoot = "web";
        inherit ((neoWeb pkgs)) pnpmDeps;
        # Mock mode generates its video samples with ffmpeg on first request.
        nativeBuildInputs = [ pkgs.nodejs_22 pkgs.pnpm pkgs.pnpmConfigHook pkgs.ffmpeg-headless (neoTypegen pkgs) ];
        env = {
          # Playwright starts its own dev server and refuses test.only.
          CI = "1";
          KIKOERU_FALLBACK_FONTS_DIR = "${fallbackFonts pkgs}";
          PLAYWRIGHT_BROWSERS_PATH = "${pkgs.playwright-driver.browsers}";
          PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS = "true";
          FONTCONFIG_FILE = pkgs.makeFontsConf { fontDirectories = [ pkgs.noto-fonts-cjk-sans ]; };
        };
        buildPhase = ''
          runHook preBuild
          cd web
          export HOME="$TMPDIR"
          neo-typegen src/lib/api/types
          pnpm exec svelte-kit sync
          # The sandbox is gone after a failure, so each failed test's page
          # snapshot goes into the build log.
          if ! pnpm exec playwright test -c playwright.mock.config.ts; then
            for f in test-results/*/error-context.md; do
              if [ -e "$f" ]; then echo "=== $f"; cat "$f"; fi
            done
            exit 1
          fi
          runHook postBuild
        '';
        installPhase = "touch $out";
      };
      # Workspace-wide checks over all crates: format, Clippy with and without
      # embed-web, and the freshness of both backends' query caches. The
      # PostgreSQL one is checked against a server that only lives in the
      # build sandbox, on a Unix socket.
      rustLint = pkgs:
        let rust = rustDev pkgs; in
        rust.craneLib.mkCargoDerivation (rust.args // {
          pnameSuffix = "-lint";
          cargoArtifacts = rust.deps;
          doInstallCargoArtifacts = false;
          nativeBuildInputs = [ pkgs.clippy pkgs.rustfmt pkgs.sqlx-cli pkgs.postgresql ];
          preBuild = copyWeb pkgs;
          buildPhaseCargoCommand = ''
            cargo fmt --all -- --check
            cargoWithProfile clippy --workspace --all-targets --locked --offline -- -D warnings
            cargoWithProfile clippy --workspace --all-targets --locked --offline --features neo-server/embed-web -- -D warnings
            export DATABASE_URL="sqlite:$TMPDIR/sqlx-check.sqlite3"
            sqlx database create
            sqlx migrate run --source crates/neo-core/migrations/sqlite
            (cd crates/neo-db-sqlite && SQLX_OFFLINE=false cargo sqlx prepare --check -- --locked --offline)
            unset DATABASE_URL
            initdb -D "$TMPDIR/pg" -U postgres --auth=trust --no-locale -E UTF8 >/dev/null
            pg_ctl -D "$TMPDIR/pg" -o "-k $TMPDIR -c listen_addresses=" -l "$TMPDIR/pg.log" -w start
            export PG_DATABASE_URL="postgres:///sqlx_check?host=$TMPDIR&user=postgres"
            sqlx database create --database-url "$PG_DATABASE_URL"
            sqlx migrate run --source crates/neo-core/migrations/postgres --database-url "$PG_DATABASE_URL"
            (cd crates/neo-db-postgres && SQLX_OFFLINE=false cargo sqlx prepare --check -- --locked --offline)
            pg_ctl -D "$TMPDIR/pg" -m fast stop
            unset PG_DATABASE_URL
          '';
        });
      # Every workspace test, with embed-web on so tests/web.rs checks the real
      # frontend build.
      rustTest = pkgs:
        let rust = rustDev pkgs; in
        rust.craneLib.cargoTest (rust.args // {
          cargoArtifacts = rust.deps;
          doInstallCargoArtifacts = false;
          nativeBuildInputs = [ pkgs.curl ];
          # neo-media tests run the real ffmpeg and ffprobe.
          nativeCheckInputs = [ pkgs.ffmpeg-headless ];
          preBuild = copyWeb pkgs;
        });
      # Run the selected database, scanner, schema-parity and copy targets
      # on PostgreSQL, not the entire workspace suite. The server lives
      # only in the build sandbox and is stopped after the tests.
      rustTestPg = pkgs:
        let rust = rustDev pkgs; in
        rust.craneLib.cargoTest (rust.args // {
          cargoArtifacts = rust.deps;
          doInstallCargoArtifacts = false;
          nativeCheckInputs = [ pkgs.postgresql pkgs.postgresqlTestHook ];
          # The tests create a database each.
          postgresqlTestUserOptions = "LOGIN CREATEDB";
          preCheck = ''
            export KIKOERU_TEST_BACKEND=postgres
            export KIKOERU_TEST_PG="postgres:///test_db?host=$NIX_BUILD_TOP/run/postgresql&user=test_user"
          '';
          cargoTestExtraArgs = "--test db --test legacy_state --test pg_schema --test db_copy --test scan --test metadata -- --include-ignored";
          preBuild = copyWeb pkgs;
        });
      # The release binary. Only the package stamps the commit into
      # /api/version: a stamp would make every check and the e2e suite rebuild
      # on each commit, and differ between a dirty and a clean tree.
      neoServerStatic = pkgs: { stamped }:
        let
          craneLib = crane.mkLib pkgs.pkgsStatic;
          args = rustCommon // {
            pname = "neo-server-static";
            cargoExtraArgs = "--locked -p neo-server --features neo-server/embed-web";
            doCheck = false;
          };
        in craneLib.buildPackage (args // {
          cargoArtifacts = craneLib.buildDepsOnly args;
          preBuild = copyWeb pkgs;
          meta.mainProgram = "kikoeru-neo";
        } // pkgs.lib.optionalAttrs stamped {
          env = rustCommon.env // {
            KIKOERU_GIT_COMMIT = self.shortRev or self.dirtyShortRev or "";
            KIKOERU_BUILD_TIME = if self ? shortRev || self ? dirtyShortRev
              then toString ((self.lastModified or 0) * 1000) else "";
          };
        });
      neoServer = pkgs: { stamped }:
        let
          craneLib = crane.mkLib pkgs;
          args = rustCommon // {
            pname = "neo-server";
            cargoExtraArgs = "--locked -p neo-server --features neo-server/embed-web";
            doCheck = false;
          };
        in
        craneLib.buildPackage (args // {
          cargoArtifacts = craneLib.buildDepsOnly args;
          nativeBuildInputs = [ pkgs.makeWrapper ];
          preBuild = copyWeb pkgs;
          # The server runs ffmpeg and ffprobe by name, so the package pins them.
          postInstall = ''
            wrapProgram $out/bin/kikoeru-neo --prefix PATH : ${pkgs.lib.makeBinPath [ (serverFfmpeg pkgs).package ]}
          '';
          meta.mainProgram = "kikoeru-neo";
        } // pkgs.lib.optionalAttrs stamped {
          # /api/version reports these. The commit time stands in for the build
          # time so that the package stays reproducible.
          env = rustCommon.env // {
            KIKOERU_GIT_COMMIT = self.shortRev or self.dirtyShortRev or "";
            KIKOERU_BUILD_TIME = if self ? shortRev || self ? dirtyShortRev
              then toString ((self.lastModified or 0) * 1000) else "";
          };
        });
    in
    {
      packages = forAllSystems (pkgs: {
        book = pkgs.stdenvNoCC.mkDerivation {
          pname = "kikoeru-neo-book";
          version = "0";
          src = ./book;
          nativeBuildInputs = [ pkgs.mdbook ];
          buildPhase = "mdbook build --dest-dir $out";
          dontInstall = true;
        };
        neo-typegen = neoTypegen pkgs;
        fallback-fonts = fallbackFonts pkgs;
        web = neoWeb pkgs;
        neo-server = neoServer pkgs { stamped = true; };
        desktop = neoDesktop pkgs;
        default = self.packages.${pkgs.stdenv.hostPlatform.system}.neo-server;
        kikoeru-neo-docker-migrate = (import ./nix/docker-migrate.nix { inherit pkgs; }).package;
        kikoeru-neo-ghcr-release = (import ./nix/ghcr-release.nix { inherit pkgs; }).package;
        docker-rootfs = import ./nix/docker-rootfs.nix {
          inherit pkgs;
          server = self.packages.${pkgs.stdenv.hostPlatform.system}.neo-server;
        };
        docker-image = import ./nix/docker.nix {
          inherit pkgs;
          server = self.packages.${pkgs.stdenv.hostPlatform.system}.neo-server;
          # A bare number makes `date -d` fail inside dockerTools.
          created = "@${toString self.lastModified}";
        };
      } // pkgs.lib.optionalAttrs pkgs.stdenv.hostPlatform.isx86_64 {
        neo-server-static = neoServerStatic pkgs { stamped = true; };
      });

      checks = forAllSystems (pkgs: {
        book = self.packages.${pkgs.stdenv.hostPlatform.system}.book;
        neo-typegen = self.packages.${pkgs.stdenv.hostPlatform.system}.neo-typegen;
        web = self.packages.${pkgs.stdenv.hostPlatform.system}.web;
        neo-server = neoServer pkgs { stamped = false; };
        # Built from the unstamped server with a fixed creation time, so this
        # check stays cached across commits like the others. Only those two
        # differ from the docker-image package.
        docker-image =
          let server = neoServer pkgs { stamped = false; };
          in import ./nix/docker-check.nix {
            inherit pkgs server;
            image = import ./nix/docker.nix { inherit pkgs server; created = "@0"; };
          };
        dockerfile = import ./nix/dockerfile-check.nix {
          inherit pkgs;
          server = neoServer pkgs { stamped = false; };
        };
        docker-rootfs = import ./nix/docker-rootfs-check.nix {
          inherit pkgs;
          server = neoServer pkgs { stamped = false; };
        };
        github-release = import ./nix/github-release-check.nix { inherit pkgs; };
        codex-review = import ./nix/codex-review.nix { inherit pkgs; };
        docker-migrate = (import ./nix/docker-migrate.nix { inherit pkgs; }).check;
        ffmpeg = (serverFfmpeg pkgs).check;
        ghcr-release = (import ./nix/ghcr-release.nix { inherit pkgs; }).check;
      } // pkgs.lib.optionalAttrs pkgs.stdenv.hostPlatform.isx86_64 {
        neo-server-static = import ./nix/static-check.nix {
          inherit pkgs;
          server = neoServerStatic pkgs { stamped = false; };
        };
        rust-lint = rustLint pkgs;
        rust-test = rustTest pkgs;
        rust-test-pg = rustTestPg pkgs;
        e2e = neoE2e pkgs (neoServer pkgs { stamped = false; });
        e2e-mock = neoE2eMock pkgs;
        windows = crossWindows pkgs;
        desktop = neoDesktop pkgs;
        desktop-windows = desktopWindows pkgs;
        docker = import ./nix/docker-test.nix {
          inherit pkgs;
          image = import ./nix/docker.nix { inherit pkgs; server = neoServer pkgs { stamped = false; }; created = "@0"; };
          migrate = (import ./nix/docker-migrate.nix { inherit pkgs; }).package;
        };
        nixos = import ./nix/test.nix { inherit self pkgs; package = neoServer pkgs { stamped = false; }; };
      });

      nixosModules.default = import ./nix/module.nix self;

      devShells = forAllSystems (pkgs: {
        default = import ./nix/dev-shell.nix { inherit pkgs; };
      });
    };
}
