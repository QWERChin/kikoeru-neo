{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "picker",
  "description": "The bundled mode picker. It has no remote URLs, so only the app's own pages get it.",
  "windows": ["main-*"],
  "permissions": [
    "allow-desktop-state",
    "allow-use-local",
    "allow-use-server",
    "allow-open-log-dir",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
